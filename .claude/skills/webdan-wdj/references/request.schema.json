{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/webdan-wdj/request.schema.json",
  "title": "WebDan WDJ semantic edit request",
  "type": "object",
  "additionalProperties": false,
  "required": ["member", "point"],
  "properties": {
    "design": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "application_id": {"type": "integer"},
        "standard_id": {"type": "integer"}
      }
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": ["m_no"],
      "properties": {
        "m_no": {"type": "integer", "minimum": 1},
        "group_name": {"type": "string", "minLength": 1},
        "section": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width_mm", "height_mm"],
          "properties": {
            "shape": {"const": "rectangle"},
            "width_mm": {"type": "number", "exclusiveMinimum": 0},
            "height_mm": {"type": "number", "exclusiveMinimum": 0}
          }
        }
      }
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index"],
      "properties": {
        "index": {"type": "integer", "minimum": 1},
        "name": {"type": "string", "minLength": 1},
        "axis": {"enum": ["My-Vz", "Mz-Vy"]},
        "checks": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "upper": {"type": "boolean"},
            "lower": {"type": "boolean"},
            "bending": {"type": "boolean"},
            "shear": {"type": "boolean"},
            "torsion": {"type": "boolean"}
          }
        }
      }
    },
    "rebar": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "upper": {"$ref": "#/$defs/rebarSide"},
        "lower": {"$ref": "#/$defs/rebarSide"}
      }
    },
    "materials": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "group_no": {"type": "number"},
        "longitudinal_grade": {"enum": ["SD295", "SD345", "SD390", "SD490"]},
        "concrete": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "fck_mpa": {"type": "number", "exclusiveMinimum": 0},
            "max_aggregate_mm": {"type": "number", "exclusiveMinimum": 0}
          }
        }
      }
    },
    "forces": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^(Md[0-8]_(Md|Nd)|Vd[0-7]_(Vd|Md|Nd)|Mt(0|1|5|6|7)_(Mt|Md|Vd|Nd))$": {
          "type": ["number", "null"]
        }
      }
    },
    "calculation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bending": {"type": "boolean"},
        "shear": {"type": "boolean"},
        "torsion": {"type": "boolean"},
        "print_calculation": {"type": "boolean"},
        "print_section_forces": {"type": "boolean"},
        "print_safety_ratios": {"type": "boolean"},
        "print_summary": {"type": "boolean"}
      }
    }
  },
  "$defs": {
    "nullableNumber": {"type": ["number", "null"]},
    "rebarSide": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "diameter_mm": {
          "type": "integer",
          "enum": [10, 12, 13, 16, 19, 20, 22, 25, 28, 29, 32, 35, 36, 38, 40, 41, 50, 51]
        },
        "count": {"type": "integer", "minimum": 2},
        "cover_to_center_mm": {"$ref": "#/$defs/nullableNumber"},
        "first_row_count": {"type": ["integer", "null"], "minimum": 1},
        "row_spacing_mm": {"$ref": "#/$defs/nullableNumber"},
        "adjacent_spacing_mm": {"$ref": "#/$defs/nullableNumber"},
        "slope_cos": {"$ref": "#/$defs/nullableNumber"}
      }
    }
  }
}
